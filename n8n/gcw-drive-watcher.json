{
  "name": "GCW — ERA Google Drive Watcher",
  "nodes": [
    {
      "id": "node_schedule",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/5 * * * *"
            }
          ]
        }
      },
      "notes": "Polls every 5 minutes. Files that succeed get moved to Processed/ subfolder by ingest-era-file, so no time-filter or dedup needed here."
    },
    {
      "id": "node_search",
      "name": "Find Unprocessed ERA Files",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [420, 300],
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "advanced",
        "queryString": "='REPLACE_WITH_ERA_FOLDER_ID' in parents and mimeType != 'application/vnd.google-apps.folder' and trashed = false",
        "returnAll": false,
        "limit": 50,
        "options": {}
      },
      "credentials": {
        "googleApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "GCP-Master-Account"
        }
      },
      "notes": "Finds all files in the ERA folder that have NOT yet been moved to Processed/. The ingest-era-file edge function moves each file after a clean insert, so this query naturally skips already-processed files. ERA folder must be shared with n8n-backend@cardio-metrics-dev.iam.gserviceaccount.com."
    },
    {
      "id": "node_ingest",
      "name": "Ingest ERA File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300],
      "parameters": {
        "method": "POST",
        "url": "https://jdmyjdvricpyrsfchakk.supabase.co/functions/v1/ingest-era-file",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ practice_id: 'df52d2fd-5e88-48de-9c45-13d0ae7847b0', gdrive_file_id: $json.id, era_folder_id: 'REPLACE_WITH_ERA_FOLDER_ID', batch_id: 'gcw-era-' + $now.toFormat('yyyy-MM-dd') }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "notes": "Passes file ID to ingest-era-file edge function. Supabase downloads, parses (CSV or XLSX), inserts to BigQuery, and moves file to Processed/ subfolder. Replace REPLACE_WITH_ERA_FOLDER_ID with the same folder ID used in the search node above."
    },
    {
      "id": "node_check",
      "name": "Check Success",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [860, 300],
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.success }}",
              "value2": true
            }
          ]
        }
      }
    },
    {
      "id": "node_error_email",
      "name": "Send Error Alert",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1080, 400],
      "parameters": {
        "fromEmail": "alerts@n2n-portal.com",
        "toEmail": "keith@n2nanalytics.com",
        "subject": "=⚠️ GCW ERA ingest error — {{ $now.toISO() }}",
        "emailType": "text",
        "message": "=GCW ERA file ingest failed.\n\nFile ID: {{ $('Find Unprocessed ERA Files').item.json.id }}\nFile name: {{ $('Find Unprocessed ERA Files').item.json.name }}\n\nResponse: {{ JSON.stringify($json, null, 2) }}\n\nCheck pipeline_events in Supabase for full error details.\nProject: jdmyjdvricpyrsfchakk"
      },
      "notes": "Only fires on failure. Success path is intentionally empty — pipeline_events in Supabase is the audit log. Configure SMTP credentials in n8n."
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Find Unprocessed ERA Files",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Unprocessed ERA Files": {
      "main": [
        [
          {
            "node": "Ingest ERA File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ingest ERA File": {
      "main": [
        [
          {
            "node": "Check Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Success": {
      "main": [
        [],
        [
          {
            "node": "Send Error Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "pinData": {},
  "tags": []
}
